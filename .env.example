# Public data provider keys.
# Look-ahead rule: congressional signals must use disclosure/FiledAfterDate, not transaction date.
QUIVER_API_KEY=
POLYGON_API_KEY=
POLYGON_CACHE_DIR=.polygon_cache
POLYGON_RATE_LIMIT_RPM=5
FRED_API_KEY=

# SEC requires a descriptive User-Agent with contact information.
# Look-ahead rule: 13F signals must use EDGAR acceptanceDatetime/filing_date, not report period.
SEC_EDGAR_USER_AGENT="AI-Trader research contact@example.com"

# Social sentiment sources
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="ai-trader-sentiment/0.1"

# LLM and memory
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TRADER_LLM_BACKEND=openai
AI_TRADER_LLM_MODEL=gpt-4.5
AI_TRADER_FINAL_REASONER_MODEL=gpt-4.5
OLLAMA_HOST=http://localhost:11434
AI_TRADER_LLM_TIMEOUT_S=60
AI_TRADER_RAG_ENABLED=false
AI_TRADER_RAG_INDEX_DIR=data/rag/trader_memory
AI_TRADER_RAG_CORPUS_DIR=examples/trader_corpus
AI_TRADER_EMBEDDINGS_BACKEND=local
AI_TRADER_LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_TRADER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://ai_trader:ai_trader@localhost:5432/ai_trader
FAISS_INDEX_PATH=data/faiss/trader_memory.index

# Runtime
AI_TRADER_ENV=dev
LOG_LEVEL=INFO
AI_TRADER_TRADING_MODE=paper
AI_TRADER_ALLOW_LIVE_TRADING=false

# IBKR (TWS/Gateway)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
IBKR_READONLY=false
